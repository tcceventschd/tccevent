  if(reelVideo){
    reelVideo.playbackRate = 1.75;
    reelVideo.addEventListener('loadedmetadata', ()=>{ reelVideo.playbackRate = 1.75; });
  }

  const rows = document.querySelectorAll('.atable-row:not(.header)');
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach((entry, idx)=>{
      if(entry.isIntersecting){
        setTimeout(()=> entry.target.classList.add('visible'), idx * 90);
        obs.unobserve(entry.target);
      }
    });
  }, {threshold:0.2});
  rows.forEach(r=> obs.observe(r));

  // animated counters
  const counters = document.querySelectorAll('.count-num');
  const counterObs = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        const el = entry.target;
        const target = parseInt(el.getAttribute('data-count'), 10);
        let current = 0;
        const step = Math.max(1, Math.round(target / 40));
        const tick = ()=>{
          current += step;
          if(current >= target){ el.textContent = target; }
          else{ el.textContent = current; requestAnimationFrame(tick); }
        };
        tick();
        counterObs.unobserve(el);
      }
    });
  }, {threshold:0.4});
  counters.forEach(c=> counterObs.observe(c));
</script>

</body>
</html>
